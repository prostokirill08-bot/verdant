# Локальная разработка (npm run dev)
DATABASE_URL="postgresql://verdant:CHANGE_ME@localhost:5432/verdant?schema=public"
REDIS_URL="redis://localhost:6379"
APP_URL="http://localhost:3000"

# Первый администратор (создаётся при сиде, если его ещё нет)
ADMIN_EMAIL="admin@verdant.local"
ADMIN_PASSWORD="CHANGE_ME_STRONG_PASSWORD"

# Только для docker compose
POSTGRES_PASSWORD="CHANGE_ME_DB_PASSWORD"
PORT=3000

# Telegram Mini App (необязательно). Токен бота от @BotFather — задаётся только здесь/в настройках хостинга.
# При старте сервер сам настроит вебхук, кнопку «Играть», команды и описание бота (нужен HTTPS-адрес сайта).
TELEGRAM_BOT_TOKEN=""
# Демо-посетители в счётчике «онлайн» (только счётчик, без ставок и рейтингов): "5-10" по умолчанию, "0" — выключить
ONLINE_BOTS=5-10
# Само-пинг против засыпания (на Render подставляется RENDER_EXTERNAL_URL автоматически)
# KEEPALIVE_URL=https://example.onrender.com
# Ставки и денежные выигрыши (новые раунды, сундук, выплаты турнира). По умолчанию выключены; "1" — включить
# WAGERING_ENABLED=1

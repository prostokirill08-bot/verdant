// Verdant — модель данных демонстрационной игровой платформы.
// Все суммы хранятся целыми числами в «центах» баллов (1 балл = 100 единиц), без float.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  SUPPORT
  ADMIN
}

enum UserStatus {
  ACTIVE
  BLOCKED
}

enum LedgerType {
  DEMO_GRANT    // стартовые и ежедневные демо-баллы
  BET           // списание ставки
  WIN           // начисление выигрыша
  REFUND        // возврат ставки (отмена раунда)
  ADMIN_ADJUST  // ручная корректировка администратором
  PROMO         // призы акций: сундук со снежными ключами, турнир недели
  DEPOSIT       // пополнение через демо-кассу (реальные деньги не участвуют)
  REWARD        // награды за достижения и ежедневные задания
}

enum RoundStatus {
  ACTIVE     // раунд идёт (Mines, Crash)
  WON
  LOST
  CANCELLED
}

model User {
  id            String     @id @default(cuid())
  publicId      String     @unique            // видимый ID игрока, например VRD-7K2Q9M
  email         String     @unique
  username      String     @unique
  passwordHash  String
  role          Role       @default(USER)
  status        UserStatus @default(ACTIVE)
  avatar        String     @default("orbit")  // ключ встроенного аватара
  telegramId    BigInt?    @unique            // вход через Telegram Mini App
  hidden        Boolean    @default(false)    // анонимный режим: ник не показывается в публичных лентах
  failedLogins  Int        @default(0)
  lockedUntil   DateTime?
  lastLoginAt   DateTime?
  lastBonusAt   DateTime?
  prefs         Json       @default("{}")     // настройки интерфейса: звук, анимации, качество эффектов
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  wallet        Wallet?
  sessions      Session[]
  rounds        Round[]
  seeds         SeedPair[]
  resets        PasswordReset[]
  ledger        LedgerEntry[]
  meters        SlotMeter[]
  promo         PromoState?
  promoWins     PromoWin[]
  deposits      Deposit[]
  favorites     Favorite[]
  activity      ActivityDay[]
  achievements  UserAchievement[]
  quests        UserQuest[]
  notifications Notification[]
  tournaments   TournamentEntry[]
}

/** Пополнение через демо-кассу. Деньги не списываются: запись нужна для истории, лимитов и отчёта в админке. */
model Deposit {
  id        String   @id @default(cuid())
  userId    String
  amount    BigInt                       // копейки
  method    String                       // card | sbp | wallet — только вид оформления
  key       String   @unique             // ключ идемпотентности: повторный клик не пополнит дважды
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([createdAt])
}

model Session {
  id         String   @id                 // SHA-256 от токена из cookie; сам токен в БД не хранится
  userId     String
  csrfToken  String
  ip         String?
  userAgent  String?
  createdAt  DateTime @default(now())
  expiresAt  DateTime
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model PasswordReset {
  id         String    @id @default(cuid())
  userId     String
  tokenHash  String    @unique
  expiresAt  DateTime
  usedAt     DateTime?
  createdAt  DateTime  @default(now())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Wallet {
  id         String        @id @default(cuid())
  userId     String        @unique
  balance    BigInt        @default(0)   // в сотых долях балла
  version    Int           @default(0)   // растёт при каждой операции (оптимистичная блокировка)
  updatedAt  DateTime      @updatedAt
  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  entries    LedgerEntry[]
}

// Неизменяемый журнал: баланс кошелька всегда равен сумме записей.
model LedgerEntry {
  id              String     @id @default(cuid())
  walletId        String
  userId          String
  type            LedgerType
  amount          BigInt                 // со знаком: ставка < 0, выигрыш > 0
  balanceAfter    BigInt
  idempotencyKey  String     @unique     // защита от повторного списания / начисления
  roundId         String?
  note            String?
  createdAt       DateTime   @default(now())
  wallet          Wallet     @relation(fields: [walletId], references: [id], onDelete: Cascade)
  user            User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([roundId])
}

model Game {
  slug         String   @id                // crash, mines, dice, roulette, plinko, limbo
  title        String
  tagline      String
  enabled      Boolean  @default(true)
  minBet       BigInt   @default(10)       // 0,10 балла
  maxBet       BigInt   @default(1000000)  // 10 000 баллов
  houseEdgeBp  Int      @default(100)      // преимущество в базисных пунктах (100 = 1%)
  sortOrder    Int      @default(0)
  category     String?                     // slots | originals | table — переопределение категории из админки
  addedAt      DateTime @default(now())    // дата появления игры (сортировка «по новизне»)
  updatedAt    DateTime @updatedAt
  rounds       Round[]
  favorites    Favorite[]
}

// Пара сидов provably fair: хэш серверного сида показан заранее, сам сид раскрывается при смене пары.
model SeedPair {
  id              String    @id @default(cuid())
  userId          String
  serverSeed      String
  serverSeedHash  String
  clientSeed      String
  nonce           Int       @default(0)
  active          Boolean   @default(true)
  revealedAt      DateTime?
  createdAt       DateTime  @default(now())
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  rounds          Round[]

  @@index([userId, active])
}

model Round {
  id          String      @id @default(cuid())
  userId      String
  gameSlug    String
  seedPairId  String?
  nonce       Int?
  betAmount   BigInt
  payout      BigInt      @default(0)
  multiplier  Decimal     @default(0) @db.Decimal(14, 4)
  status      RoundStatus @default(ACTIVE)
  params      Json                         // настройки раунда, выбранные игроком
  state       Json?                        // промежуточное состояние (Mines: открытые клетки)
  result      Json?                        // итог, который видит игрок
  createdAt   DateTime    @default(now())
  settledAt   DateTime?
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  game        Game        @relation(fields: [gameSlug], references: [slug])
  seedPair    SeedPair?   @relation(fields: [seedPairId], references: [id])
  crashId     String?                      // для Crash: общий раунд, в котором сделана ставка
  crash       CrashRound? @relation(fields: [crashId], references: [id])

  @@unique([crashId, userId])                // одна ставка на игрока в раунде Crash
  @@index([userId, createdAt])
  @@index([gameSlug, createdAt])
  @@index([gameSlug, settledAt])             // лента «Все игроки»
  @@index([status])
}

enum CrashStatus {
  BETTING
  RUNNING
  CRASHED
  CANCELLED
}

// Общий раунд Crash для всех игроков. Хэш сида публикуется до старта, сид — после обвала.
model CrashRound {
  id              String      @id @default(cuid())
  serverSeed      String
  serverSeedHash  String
  edgeBp          Int
  crashPoint      Decimal     @db.Decimal(14, 2)
  status          CrashStatus @default(BETTING)
  bettingEndsAt   DateTime
  startedAt       DateTime?
  crashedAt       DateTime?
  createdAt       DateTime    @default(now())
  rounds          Round[]

  @@index([status, createdAt])
}

model AuditLog {
  id          String   @id @default(cuid())
  actorId     String?
  action      String                       // auth.login, wallet.adjust, admin.game.update …
  targetType  String?
  targetId    String?
  ip          String?
  meta        Json?
  createdAt   DateTime @default(now())

  @@index([action, createdAt])
  @@index([actorId, createdAt])
}

model Setting {
  key        String   @id
  value      Json
  updatedAt  DateTime @updatedAt
}

/// Накопительные шкалы слота (сундуки «Мастерской Санты»): переживают спины, по одной строке на игрока и игру.
model SlotMeter {
  userId    String
  gameSlug  String
  state     Json
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, gameSlug])
}

/// Снежные ключи игрока: выпадают за ставки, 4 ключа открывают сундук.
model PromoState {
  userId     String   @id
  keys       Int      @default(0)
  opened     Int      @default(0)
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// Выигрыши акций: призы из сундука и места в турнире недели (лента и защита от двойной выплаты).
model PromoWin {
  id         String   @id @default(cuid())
  userId     String
  kind       String                       // chest | grand | tournament
  amount     BigInt
  week       String?                      // неделя турнира, например 2026-W45
  place      Int?
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([week, place])
  @@index([createdAt])
}

/// Избранные игры игрока (сохраняются между сессиями и устройствами).
model Favorite {
  userId    String
  gameSlug  String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  game      Game     @relation(fields: [gameSlug], references: [slug], onDelete: Cascade)

  @@id([userId, gameSlug])
}

/// Дни, в которые игрок заходил на платформу (по Москве, YYYY-MM-DD). Нужны для достижений и заданий.
model ActivityDay {
  userId    String
  day       String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, day])
  @@index([day])
}

/// Описание достижения. metric — что считаем (rounds_total, wins_total …), target — сколько нужно.
model AchievementDef {
  code        String   @id
  title       String
  description String
  icon        String                       // ключ встроенной иконки
  metric      String
  target      Int
  reward      BigInt   @default(0)         // демо-рубли (в сотых)
  enabled     Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  unlocked    UserAchievement[]
}

/// Полученное достижение. Составной ключ — достижение нельзя получить дважды.
model UserAchievement {
  userId     String
  code       String
  unlockedAt DateTime @default(now())
  reward     BigInt   @default(0)
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  def        AchievementDef @relation(fields: [code], references: [code], onDelete: Cascade)

  @@id([userId, code])
  @@index([code])
}

/// Шаблон ежедневного задания. pinned — показывается каждый день, остальные чередуются.
model QuestDef {
  code        String   @id
  title       String
  description String
  metric      String                       // rounds_today, games_today, categories_today, new_game_today, visit_today …
  target      Int
  reward      BigInt   @default(0)
  enabled     Boolean  @default(true)
  pinned      Boolean  @default(false)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  progress    UserQuest[]
}

/// Выполнение задания за конкретный день. Ключ (игрок, день, задание) — награду нельзя получить дважды.
model UserQuest {
  userId      String
  day         String
  code        String
  completedAt DateTime @default(now())
  claimedAt   DateTime?
  reward      BigInt   @default(0)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  def         QuestDef @relation(fields: [code], references: [code], onDelete: Cascade)

  @@id([userId, day, code])
  @@index([day])
}

/// Внутренние уведомления: достижения, задания, турниры, ежедневная награда.
model Notification {
  id        String    @id @default(cuid())
  userId    String
  kind      String                         // achievement | quest | tournament_start | tournament_end | daily_bonus | system
  title     String
  body      String
  link      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, readAt])
}

/// Завершённый (или идущий) турнир недели. id — неделя, например 2026-W45.
model Tournament {
  id          String    @id
  title       String
  startsAt    DateTime
  endsAt      DateTime
  status      String    @default("ACTIVE") // ACTIVE | FINISHED
  prizes      Json                         // призы по местам (строки, копейки)
  notifiedAt  DateTime?                    // уведомление о старте разослано
  finishedAt  DateTime?
  entries     TournamentEntry[]
}

/// Итоговая таблица турнира (фиксируется при завершении).
model TournamentEntry {
  tournamentId String
  place        Int
  userId       String
  score        Decimal  @db.Decimal(14, 4)  // лучший множитель
  game         String
  prize        BigInt   @default(0)
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([tournamentId, place])
  @@index([userId])
}

/// Системные ошибки сервера и клиента — видны в админке.
model ErrorLog {
  id        String   @id @default(cuid())
  source    String                          // api | job | client
  path      String?
  message   String
  stack     String?
  userId    String?
  createdAt DateTime @default(now())

  @@index([createdAt])
}

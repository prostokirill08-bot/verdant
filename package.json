{
  "name": "verdant",
  "version": "0.1.0",
  "private": true,
  "description": "Verdant — демонстрационная игровая платформа на виртуальных баллах",
  "scripts": {
    "dev": "tsx watch --clear-screen=false --ignore ./.next server.ts",
    "build": "next build",
    "start": "NODE_ENV=production tsx server.ts",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "test": "tsx --test src/**/*.test.ts",
    "test:e2e": "node tests/e2e.mjs"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "framer-motion": "12.43.0",
    "ioredis": "5.11.1",
    "next": "15.5.28",
    "react": "19.1.10",
    "react-dom": "19.1.10",
    "tsx": "4.23.15",
    "ws": "8.22.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.1.18",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/ws": "8.18.2",
    "prisma": "6.19.3",
    "tailwindcss": "4.1.18",
    "typescript": "5.9.3"
  }
}

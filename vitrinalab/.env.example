# Скопируйте в .env и заполните. Файл .env никогда не коммитится.
# Комментарии — только на отдельных строках (не после значения).

# --- Адрес и доступы (bootstrap.sh заполняет сам) ---
DOMAIN=vitrinalab.ru
PUBLIC_URL=https://vitrinalab.ru
POSTGRES_PASSWORD=
APP_SECRET=
ADMIN_USER=admin
ADMIN_PASSWORD=

# --- Реквизиты самозанятого (оферта, политика ПД, подвал сайта) ---
OWNER_FULL_NAME=
OWNER_INN=
OWNER_EMAIL=

# --- AI: Yandex Cloud ---
# mock | yandex | gigachat   (mock — без ключей, тексты делает запасной алгоритм)
LLM_PROVIDER=mock
# none | yandexart
IMAGE_PROVIDER=none
YANDEX_API_KEY=
YANDEX_FOLDER_ID=
YANDEX_MODEL=yandexgpt-lite/latest
# GIGACHAT_AUTH_KEY=
# GIGACHAT_CA_BUNDLE=/app/data/russian_trusted_root_ca.cer
DAILY_AI_BUDGET_RUB=500
# цены провайдера в копейках — сверить с тарифами Yandex Cloud
LLM_PRICE_IN_PER_1K_KOP=20
LLM_PRICE_OUT_PER_1K_KOP=20
IMAGE_PRICE_KOP=200

# --- Платежи ---
# manual (СБП + подтверждение в админке) | yookassa
PAYMENT_PROVIDER=manual
MANUAL_PAYMENT_DETAILS="Перевод по СБП на номер +7XXXXXXXXXX (Банк), получатель: Имя О."
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
# chat id владельца можно не заполнять: напишите боту /owner <код из админки>
TELEGRAM_OWNER_CHAT_ID=
# канал для постов: @имя_канала (бот должен быть админом канала)
TELEGRAM_CHANNEL_ID=
TELEGRAM_POLLING=true

# --- E-mail (необязательно) ---
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

DAILY_REPORT_HOUR=21

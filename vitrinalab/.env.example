# Скопируйте в .env и заполните. Файл .env никогда не коммитится.
PUBLIC_URL=https://vitrinalab.ru
APP_SECRET=сгенерируйте_длинную_случайную_строку
ADMIN_USER=admin
ADMIN_PASSWORD=сложный_пароль
# DATABASE_URL=postgresql+psycopg://vitrina:pass@db:5432/vitrina   # пусто → SQLite в data/

# Реквизиты самозанятого (для оферты, политики ПД, футера)
OWNER_FULL_NAME=
OWNER_INN=
OWNER_EMAIL=

# AI (Yandex Cloud: сервисный аккаунт с ролью ai.languageModels.user и ai.imageGeneration.user)
LLM_PROVIDER=yandex            # mock | yandex | gigachat
IMAGE_PROVIDER=none            # none | yandexart
YANDEX_API_KEY=
YANDEX_FOLDER_ID=
YANDEX_MODEL=yandexgpt-lite/latest
# GIGACHAT_AUTH_KEY=
# GIGACHAT_CA_BUNDLE=/app/certs/russian_trusted_root_ca.cer
DAILY_AI_BUDGET_RUB=500
# Цены провайдера в копейках — сверить с тарифами Yandex Cloud
LLM_PRICE_IN_PER_1K_KOP=20
LLM_PRICE_OUT_PER_1K_KOP=20
IMAGE_PRICE_KOP=200

# Платежи
PAYMENT_PROVIDER=manual        # manual | yookassa
MANUAL_PAYMENT_DETAILS="Перевод по СБП на номер +7XXXXXXXXXX (Банк), получатель: Имя О."
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_CHAT_ID=        # ваш chat id для отчётов и эскалаций
TELEGRAM_CHANNEL_ID=           # @channel для постов Marketing-агента
TELEGRAM_POLLING=true

# E-mail (необязательно)
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

DAILY_REPORT_HOUR=21
